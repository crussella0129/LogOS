# LogOS — kernel + LUKS integration USE flags
# These ensure dracut builds initramfs with LUKS support and GRUB can boot it.

# installkernel: use dracut (not genkernel) and grub (auto-update on kernel install)
sys-kernel/installkernel dracut grub

# systemd: enable cryptsetup support for /etc/crypttab
sys-apps/systemd cryptsetup

# grub: device-mapper support for encrypted root
sys-boot/grub device-mapper

# cryptsetup: argon2 KDF (safe because /boot is unencrypted, GRUB never touches LUKS)
sys-fs/cryptsetup argon2

# Break circular dependency: libwebp <-> tiff (known Gentoo bootstrap issue)
# After initial install, remove this line and re-emerge both with full USE.
media-libs/tiff -webp

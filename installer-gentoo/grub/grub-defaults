# LogOS Gentoo — /etc/default/grub
# GRUB configuration for Ringed City multi-kernel boot

GRUB_DEFAULT=saved
GRUB_SAVEDEFAULT=true
GRUB_TIMEOUT=10
GRUB_DISTRIBUTOR="LogOS"
GRUB_CMDLINE_LINUX_DEFAULT=""
GRUB_CMDLINE_LINUX="rd.luks.uuid=@CRYPT_UUID@ root=UUID=@BTRFS_UUID@ rootflags=subvol=@ rd.luks.name=@CRYPT_UUID@=cryptroot"
# GRUB_ENABLE_CRYPTODISK not needed — /boot is on a separate unencrypted partition
GRUB_DISABLE_OS_PROBER=false
GRUB_GFXMODE=auto
GRUB_GFXPAYLOAD_LINUX=keep
GRUB_TERMINAL_OUTPUT=gfxterm

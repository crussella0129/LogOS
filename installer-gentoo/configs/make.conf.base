# LogOS Gentoo — /etc/portage/make.conf
# Base configuration for Ringed City build

# Compiler flags — optimize for native hardware
COMMON_FLAGS="-march=native -O2 -pipe"
CFLAGS="${COMMON_FLAGS}"
CXXFLAGS="${COMMON_FLAGS}"
FCFLAGS="${COMMON_FLAGS}"
FFLAGS="${COMMON_FLAGS}"
RUSTFLAGS="-C target-cpu=native"

# Parallel build jobs (set to nproc during install)
MAKEOPTS="-j$(nproc) -l$(nproc)"

# Global USE flags — LogOS defaults
USE="systemd networkmanager bluetooth pulseaudio pipewire vulkan wayland \
     apparmor audit pam crypt luks btrfs zstd lzma lz4 \
     rust dbus policykit udisks \
     -gnome -kde -qt5 -gtk2 -telemetry -test"

# Accept all free licenses + linux-fw-redistributable
ACCEPT_LICENSE="-* @FREE @BINARY-REDISTRIBUTABLE linux-fw-redistributable"

# Features
FEATURES="parallel-fetch candy ccache"
CCACHE_DIR="/var/cache/ccache"
CCACHE_SIZE="10G"

# Portage directories
PORTDIR="/var/db/repos/gentoo"
DISTDIR="/var/cache/distfiles"
PKGDIR="/var/cache/binpkgs"

# Mirrors (auto-select via mirrorselect during install)
# GENTOO_MIRRORS=""

# Video cards (set by phase3 GPU detection)
# VIDEO_CARDS="amdgpu radeonsi"
# VIDEO_CARDS="nvidia"
# VIDEO_CARDS="intel"

# Input devices
INPUT_DEVICES="libinput"

# Grub platforms
GRUB_PLATFORMS="efi-64"

# Locale
L10N="en"
LINGUAS="en"

# Python targets
PYTHON_TARGETS="python3_11 python3_12"
PYTHON_SINGLE_TARGET="python3_12"

# Emerge default options
EMERGE_DEFAULT_OPTS="--jobs=4 --load-average=$(nproc)"

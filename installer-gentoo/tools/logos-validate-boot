#!/usr/bin/env bash
# LogOS Gentoo — Post-Boot Validation
# Checks that the system is correctly configured after installation
#
# Usage: logos-validate-boot [--verbose]

set -euo pipefail

VERBOSE="${1:-}"
PASS=0
FAIL=0
WARN=0

green()  { echo -e "\e[32m$*\e[0m"; }
red()    { echo -e "\e[31m$*\e[0m"; }
yellow() { echo -e "\e[33m$*\e[0m"; }

check_pass() { green "  PASS: $*"; ((PASS++)); }
check_fail() { red   "  FAIL: $*"; ((FAIL++)); }
check_warn() { yellow "  WARN: $*"; ((WARN++)); }

section() { echo ""; echo "== $* =="; }

# ── Encryption ────────────────────────────────────────────────────
section "Disk Encryption"
if lsblk -o TYPE | grep -q crypt; then
  check_pass "LUKS volume active"
else
  check_fail "No LUKS volume detected"
fi

if cryptsetup status cryptroot &>/dev/null; then
  cipher="$(cryptsetup status cryptroot | grep 'cipher:' | awk '{print $2}')"
  check_pass "cryptroot active (cipher: ${cipher:-unknown})"
else
  check_fail "cryptroot not found"
fi

# ── Filesystem ────────────────────────────────────────────────────
section "Btrfs Subvolumes"
for subvol in @ @home @canon @mesh @snapshots @log; do
  mount_check=""
  case "${subvol}" in
    "@")          mount_check="/" ;;
    "@home")      mount_check="/home" ;;
    "@canon")     mount_check="/srv/cold-canon" ;;
    "@mesh")      mount_check="/srv/warm-mesh" ;;
    "@snapshots") mount_check="/.snapshots" ;;
    "@log")       mount_check="/var/log" ;;
  esac

  if mountpoint -q "${mount_check}" 2>/dev/null; then
    if findmnt -n -o FSTYPE "${mount_check}" 2>/dev/null | grep -q btrfs; then
      check_pass "Subvol ${subvol} mounted at ${mount_check}"
    else
      check_fail "Mount ${mount_check} is not btrfs"
    fi
  else
    check_fail "Subvol ${subvol} not mounted at ${mount_check}"
  fi
done

# ── Kernels ───────────────────────────────────────────────────────
section "Kernel Installation"
zen_count="$(ls /boot/vmlinuz-*zen* 2>/dev/null | wc -l)"
stable_count="$(ls /boot/vmlinuz-*gentoo* 2>/dev/null | wc -l)"
hardened_count="$(ls /boot/vmlinuz-*hardened* 2>/dev/null | wc -l)"

[[ "${zen_count}" -gt 0 ]]    && check_pass "Zen kernel installed (${zen_count})"        || check_fail "No zen kernel found"
[[ "${stable_count}" -gt 0 ]] && check_pass "Stable kernel installed (${stable_count})"   || check_fail "No stable kernel found"
[[ "${hardened_count}" -gt 0 ]] && check_pass "Hardened kernel installed" || check_warn "No hardened kernel (optional)"

# ── GRUB ──────────────────────────────────────────────────────────
section "GRUB Configuration"
if [[ -f /boot/grub/grub.cfg ]]; then
  check_pass "grub.cfg exists"
  for profile in "Gael" "Midir" "Halflight"; do
    if grep -q "${profile}" /boot/grub/grub.cfg; then
      check_pass "Ringed City profile: ${profile}"
    else
      check_fail "Missing profile: ${profile}"
    fi
  done
else
  check_fail "grub.cfg not found"
fi

if [[ -x /etc/grub.d/41_logos_profiles ]]; then
  check_pass "41_logos_profiles installed and executable"
else
  check_fail "41_logos_profiles missing or not executable"
fi

# ── Security Services ────────────────────────────────────────────
section "Security Services"
for svc in apparmor auditd ufw fail2ban sshd; do
  if systemctl is-enabled --quiet "${svc}.service" 2>/dev/null; then
    if systemctl is-active --quiet "${svc}.service" 2>/dev/null; then
      check_pass "${svc}: enabled and active"
    else
      check_warn "${svc}: enabled but not active"
    fi
  else
    check_fail "${svc}: not enabled"
  fi
done

# ── Sysctl Hardening ─────────────────────────────────────────────
section "Kernel Hardening"
if [[ -f /etc/sysctl.d/99-logos-hardening.conf ]]; then
  check_pass "Sysctl hardening config installed"

  if [[ "${VERBOSE}" == "--verbose" ]]; then
    kptr="$(sysctl -n kernel.kptr_restrict 2>/dev/null || echo "?")"
    dmesg="$(sysctl -n kernel.dmesg_restrict 2>/dev/null || echo "?")"
    [[ "${kptr}" == "2" ]] && check_pass "kptr_restrict = 2" || check_warn "kptr_restrict = ${kptr} (expected 2)"
    [[ "${dmesg}" == "1" ]] && check_pass "dmesg_restrict = 1" || check_warn "dmesg_restrict = ${dmesg} (expected 1)"
  fi
else
  check_fail "Sysctl hardening config missing"
fi

# ── SSH Hardening ─────────────────────────────────────────────────
section "SSH Configuration"
if [[ -f /etc/ssh/sshd_config.d/10-logos-ssh.conf ]]; then
  check_pass "SSH hardening config installed"
else
  check_fail "SSH hardening config missing"
fi

# ── Boot Watchdog ─────────────────────────────────────────────────
section "Kernel Watchdog"
if systemctl is-enabled --quiet logos-kernel-watchdog.timer 2>/dev/null; then
  check_pass "Kernel watchdog timer enabled"
else
  check_fail "Kernel watchdog timer not enabled"
fi

if [[ -x /usr/local/lib/logos/kernel-watchdog.sh ]]; then
  check_pass "Watchdog script installed"
else
  check_fail "Watchdog script missing"
fi

# ── Branding ──────────────────────────────────────────────────────
section "LogOS Branding"
if [[ -f /etc/logos-release ]]; then
  check_pass "logos-release present"
  if grep -q "Gentoo" /etc/logos-release; then
    check_pass "Base identified as Gentoo"
  else
    check_warn "Base not identified as Gentoo"
  fi
else
  check_fail "logos-release missing"
fi

# ── Summary ───────────────────────────────────────────────────────
echo ""
echo "========================================"
echo "  LogOS Boot Validation Summary"
echo "  PASS: ${PASS}  FAIL: ${FAIL}  WARN: ${WARN}"
echo "========================================"

if [[ "${FAIL}" -gt 0 ]]; then
  echo ""
  red "Some checks failed. Review output above."
  exit 1
fi

exit 0

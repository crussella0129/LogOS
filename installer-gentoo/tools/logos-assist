#!/usr/bin/env bash
# LogOS — LLM Assistant CLI
# Interface to locally-running Ollama models
#
# Usage: logos-assist "your question"
#        logos-assist              (interactive mode)
#        LOGOS_MODEL=mistral:7b logos-assist "query"

set -euo pipefail

MODEL="${LOGOS_MODEL:-llama3.1:8b}"

# Check Ollama is available
if ! command -v ollama >/dev/null 2>&1; then
  echo "Error: Ollama is not installed." >&2
  echo "Install with: curl -fsSL https://ollama.com/install.sh | sh" >&2
  exit 1
fi

# Check Ollama service is running
if ! systemctl is-active --quiet ollama.service 2>/dev/null; then
  echo "Warning: Ollama service is not running. Starting..." >&2
  if [[ "${EUID}" -eq 0 ]]; then
    systemctl start ollama.service
    sleep 2
  else
    echo "Run: sudo systemctl start ollama.service" >&2
    exit 1
  fi
fi

if [[ -z "${1:-}" ]]; then
  echo "LogOS Assistant (Model: ${MODEL})"
  echo "Type your query, or 'exit' to quit"
  echo "---"
  while true; do
    read -r -p ">>>>> " query
    [[ "${query}" == "exit" ]] && break
    [[ -z "${query}" ]] && continue
    ollama run "${MODEL}" "${query}"
    echo ""
  done
else
  ollama run "${MODEL}" "$*"
fi

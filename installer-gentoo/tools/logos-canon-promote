#!/usr/bin/env bash
# LogOS — Cold Canon Governance Tool
# Promote files from Hot Workspace → Warm Mesh → Cold Canon
#
# Usage: logos-canon-promote <file> [--to cold|warm]
#        logos-canon-promote --status
#        logos-canon-promote --list [cold|warm|hot]

set -euo pipefail

COLD_CANON="/srv/cold-canon"
WARM_MESH="/srv/warm-mesh"
HOT_WORKSPACE="/srv/hot-workspace"

usage() {
  cat << 'EOF'
LogOS Cold Canon Governance Tool

Usage:
  logos-canon-promote <file> [--to cold|warm]    Promote a file
  logos-canon-promote --status                   Show canon statistics
  logos-canon-promote --list [cold|warm|hot]      List contents

Promotion Path:
  Hot Workspace → Warm Mesh → Cold Canon (copies=2, archival)

The Cold Canon is the archival layer. Files promoted to cold canon
are protected by Btrfs copies=2 for bitrot resistance.
EOF
  exit 0
}

canon_status() {
  echo "=== LogOS Knowledge Topology ==="
  echo ""
  printf "  Cold Canon:    %s files, %s\n" \
    "$(find "${COLD_CANON}" -type f 2>/dev/null | wc -l)" \
    "$(du -sh "${COLD_CANON}" 2>/dev/null | awk '{print $1}')"
  printf "  Warm Mesh:     %s files, %s\n" \
    "$(find "${WARM_MESH}" -type f 2>/dev/null | wc -l)" \
    "$(du -sh "${WARM_MESH}" 2>/dev/null | awk '{print $1}')"
  printf "  Hot Workspace: %s files, %s\n" \
    "$(find "${HOT_WORKSPACE}" -type f 2>/dev/null | wc -l)" \
    "$(du -sh "${HOT_WORKSPACE}" 2>/dev/null | awk '{print $1}')"
}

canon_list() {
  local tier="${1:-cold}"
  case "${tier}" in
    cold) echo "=== Cold Canon ===" && find "${COLD_CANON}" -type f | sort ;;
    warm) echo "=== Warm Mesh ===" && find "${WARM_MESH}" -type f | sort ;;
    hot)  echo "=== Hot Workspace ===" && find "${HOT_WORKSPACE}" -type f | sort ;;
    *)    echo "Unknown tier: ${tier}"; exit 1 ;;
  esac
}

promote_file() {
  local src="$1"
  local dest_tier="${2:-warm}"

  if [[ ! -f "${src}" ]]; then
    echo "Error: File not found: ${src}" >&2
    exit 1
  fi

  local filename
  filename="$(basename "${src}")"
  local dest_dir

  case "${dest_tier}" in
    cold)
      dest_dir="${COLD_CANON}/documents"
      ;;
    warm)
      dest_dir="${WARM_MESH}"
      ;;
    *)
      echo "Error: Unknown tier '${dest_tier}'. Use 'cold' or 'warm'." >&2
      exit 1
      ;;
  esac

  mkdir -p "${dest_dir}"

  # Checksum before copy
  local src_hash
  src_hash="$(sha256sum "${src}" | awk '{print $1}')"

  cp --preserve=all "${src}" "${dest_dir}/${filename}"

  # Verify copy
  local dst_hash
  dst_hash="$(sha256sum "${dest_dir}/${filename}" | awk '{print $1}')"

  if [[ "${src_hash}" == "${dst_hash}" ]]; then
    echo "Promoted: ${src} → ${dest_dir}/${filename}"
    echo "SHA-256:  ${src_hash}"
  else
    echo "ERROR: Checksum mismatch after copy!" >&2
    rm -f "${dest_dir}/${filename}"
    exit 1
  fi
}

# ── Main ──────────────────────────────────────────────────────────
case "${1:-}" in
  --help|-h|"") usage ;;
  --status)     canon_status ;;
  --list)       canon_list "${2:-cold}" ;;
  *)
    file="$1"
    shift
    dest="warm"
    while [[ $# -gt 0 ]]; do
      case "$1" in
        --to) dest="$2"; shift 2 ;;
        *) echo "Unknown option: $1"; exit 1 ;;
      esac
    done
    promote_file "${file}" "${dest}"
    ;;
esac
